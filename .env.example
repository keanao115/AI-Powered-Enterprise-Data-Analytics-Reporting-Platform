# Enterprise AI Data Analytics Platform Configuration

# Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Databases
# Application DB (PostgreSQL or SQLite fallback for local demo)
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Analytics DB (PostgreSQL or DuckDB fallback for local demo)
ANALYTICS_DATABASE_URL=duckdb:///./analytics_demo.duckdb

# AI / LLM Configuration
# Options: mock, openai, anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ALLOW_EXTERNAL_LLM_DATA=false

# Security & Governance Policy Limits
MAX_QUERY_ROWS=10000
MAX_QUERY_SECONDS=30
MAX_SANDBOX_SECONDS=15
MAX_EXPORT_ROWS=50000
AI_DAILY_BUDGET_USD=50.0

# Feature Flags
ENABLE_SANDBOX=true
ENABLE_REPORTS=true
ENABLE_EXPORTS=true
ENABLE_MULTI_TENANCY=true
ENABLE_PII_FIREWALL=true
ENABLE_GROUNDING_VALIDATOR=true
